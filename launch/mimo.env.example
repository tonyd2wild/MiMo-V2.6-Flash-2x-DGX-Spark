# MiMo-V2.6-Flash-RL on 2x DGX Spark: site settings. Copy to launch/mimo.env and edit.
# Both Sparks of a pair use the same file; only the rank argument differs.

# IP of the HEAD Spark (rank 0) on the Spark-to-Spark (RoCE) link. The API is served here.
HEAD_IP=192.168.100.10
# Rendezvous port between the two Sparks (any free port, same on both).
MASTER_PORT=29650

# Host path of the model folder (from setup.sh). Must exist on BOTH Sparks: a local copy
# on each, or the head's copy exported read-only over NFS and mounted at the same path.
MODEL_DIR=/var/tmp/models/MiMo-V2.6-Flash-RL

# Where setup.sh put the patched vLLM files and the fixed DFlash config (on both Sparks).
CACHE=/var/tmp/mimo-cache

# Spark-to-Spark network. These are the DGX Spark defaults for the QSFP port; check with
#   ip -br addr      (interface with the link IP)      ibdev2netdev    (HCA name)
IFACE=enp1s0f0np0
HCA=rocep1s0f0
# NCCL address range covering both Sparks' link IPs.
ADDR_RANGE=192.168.100.0/24

# Serving
TP=2              # 2 = one pair of Sparks; 4 = all four Sparks as one instance (see TP4 section in the README)
LINEAR_BACKEND=auto  # TP4 needs 'triton': the CUTLASS fp8 kernel rejects the 3392-row per-rank QKV shape on GB10
PORT=8888
KV_DTYPE=fp8      # fp8 (default) or auto (= bf16 KV)
GMU=0.90          # TP2. Use 0.85 for TP4 (vLLM's startup probe uses CUDA free memory, lower than MemAvailable)
MAXLEN=300000
SEQS=8
SPEC=dflash       # dflash or none
THINKING=false    # server default for the chat template; a request can still pass chat_template_kwargs.enable_thinking
REP_PENALTY=1.05  # server default repetition_penalty (on top of the checkpoint's temperature 1.0 / top_p 0.95); agents that send no sampling params get these
